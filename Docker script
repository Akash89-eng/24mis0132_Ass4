pipeline {
    agent any

    environment {
        DOCKER_EXE      = 'C:\\Users\\NAVEEN\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        IMAGE_NAME      = 'book-store-app'
        IMAGE_TAG       = 'latest'
        HOST_PORT       = '8081'
        CONTAINER_PORT  = '80'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo '📥 Cloning repository...'
                git branch: 'main', url: 'https://github.com/Naveen24102006/online-book-store.git'
                echo '✅ Code checked out successfully'
            }
        }

        stage('Verify Docker') {
            steps {
                echo '🐳 Checking Docker...'
                bat '"%DOCKER_EXE%" --version'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🏗️ Building Docker image...'
                bat '"%DOCKER_EXE%" build -t akash0708/%IMAGE_NAME%:%IMAGE_TAG% .'
            }
        }

        stage('Login to DockerHub') {
            steps {
                echo '🔐 Logging into DockerHub...'
                // Fixed: Matches your 'Username with password' credential type
                withCredentials([usernamePassword(credentialsId: 'docker-hub-token', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PAT')]) {
                    bat 'echo %DOCKER_PAT%| "%DOCKER_EXE%" login -u %DOCKER_USER% --password-stdin'
                }
            }
        }

        stage('Push Image') {
            steps {
                echo '📤 Pushing image to DockerHub...'
                withCredentials([usernamePassword(credentialsId: 'docker-hub-token', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PAT')]) {
                    bat '"%DOCKER_EXE%" push %DOCKER_USER%/%IMAGE_NAME%:%IMAGE_TAG%'
                }
            }
        }

        stage('Deploy Container') {
            steps {
                echo '🚀 Refreshing container deployment...'
                bat '''
                    @echo off
                    "%DOCKER_EXE%" stop test-bookstore >nul 2>&1 || exit 0
                    "%DOCKER_EXE%" rm test-bookstore >nul 2>&1 || exit 0
                '''
                bat '"%DOCKER_EXE%" run -d -p %HOST_PORT%:%CONTAINER_PORT% --name test-bookstore naveen24102006/%IMAGE_NAME%:%IMAGE_TAG%'
            }
        }
    }

    post {
        success {
            echo '🎉 PIPELINE SUCCESSFUL!'
            echo "Website running at: http://localhost:8081"
        }
        failure {
            echo '❌ PIPELINE FAILED!'
        }
    }
}
